        "revision": "92087988d05d0fe38b11f021f0b0d00a75afb86b",
        "license": "CC-BY-4.0",
        "files": [
          {
            "path": "config.json",
            "bytes": 6153,
            "sha256": "8c89a1cfe10e9f4618aded3f29d64a49aefd51e0bafd9a1aac0b26a5628e7530"
          },
          {
            "path": "model.safetensors",
            "bytes": 9836752784,
            "sha256": "045ac86f5be520d37020c94ef13cad3a84e336f18d82166748fd6b36a305540e"
          }
        ],
        "when": {
          "node": "music",
          "setting": "model",
